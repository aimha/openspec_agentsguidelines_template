# ============================================================
# ROLE: Local pre-commit gate: no commits on main/develop, file size limit, generated files in sync
# DEPENDS ON: git, scripts/sync-agents.js
# USED BY: Husky (core.hooksPath .husky/_)
# KEY DECISIONS: 500KB limit per staged file; sync check runs on the working tree
# GOTCHAS: Skippable with --no-verify: CI repeats the sync check, branch protection covers main.
#   Generated files changed but not staged also block the commit.
# LAST UPDATED: 2026-10-21 - header added
# ============================================================

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# ── Block commits on main/develop ────────────────────────────────────────────
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "develop" ]; then
  echo ""
  echo "❌  Commit diretto su '$BRANCH' non consentito."
  echo "    Apri un branch dedicato (feature/*, fix/*, ...)."
  echo ""
  exit 1
fi

# ── File size ────────────────────────────────────────────────────────────────
MAX_SIZE_KB=500
STAGED=$(git diff --cached --name-only)

for FILE in $STAGED; do
  if [ -f "$FILE" ]; then
    SIZE_KB=$(du -k "$FILE" | cut -f1)
    if [ "$SIZE_KB" -gt "$MAX_SIZE_KB" ]; then
      echo ""
      echo "❌  File troppo grande: $FILE (${SIZE_KB}KB > ${MAX_SIZE_KB}KB)"
      echo "    Suddividi il file o usa git-lfs per asset binari."
      echo ""
      exit 1
    fi
  fi
done

# ── Generated agent files in sync ────────────────────────────────────────────
node scripts/sync-agents.js --check || exit 1

git diff --quiet -- AGENTS.md CLAUDE.md .cursor/ || {
  echo "❌  File generati modificati ma non in staging: git add AGENTS.md CLAUDE.md .cursor/"
  exit 1
}
